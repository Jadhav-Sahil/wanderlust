<nav class="navbar">

    <!-- Logo -->
    <div class="navbar-logo">
        <a href="/">
            <i class="fa-regular fa-compass"></i>
            <span class="logo-text">Wanderlust</span>
        </a>
    </div>

    <!-- Search -->
    <form class="search-form mx-auto" action="/listings/search" method="GET">
        <input type="text" name="search" class="search-input" placeholder="Search places, cities, stays...">

        <button class="search-btn">
            <i class="bi bi-search"></i>
        </button>
    </form>

    <!-- Links -->
    <div class="navbar-links">

        <a href="/">
            <i class="fa-solid fa-house"></i>
            <span class="link-text">Home</span>
        </a>

        <a href="/listings">
            <i class="fa-solid fa-list"></i>
            <span class="link-text">All Listings</span>
        </a>

        <% if(currUser) { %>

            <a href="/listings/new">
                <i class="fa-solid fa-plus"></i>
                <span class="link-text">Add New</span>
            </a>

            <a href="/logout">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span class="link-text">Logout</span>
            </a>

            <% } else { %>

                <a href="/login">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span class="link-text">Login</span>
                </a>

                <a href="/signup">
                    <i class="fa-solid fa-user-plus"></i>
                    <span class="link-text">Sign Up</span>
                </a>

                <% } %>

    </div>

</nav>