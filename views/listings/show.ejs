<% layout("/layouts/boilerplate") %>

    <div class="show-container">

        <div class="show-image-wrapper">
            <% let imageUrl="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267" ; if(listing.image){
                if(typeof listing.image==="string" ){ imageUrl=listing.image; } else if(listing.image.url){
                imageUrl=listing.image.url; } } %>

                <img src="<%= imageUrl %>" alt="<%= listing.title %>" class="show-image">
        </div>

        <div class="show-content-layout">

            <div class="show-main-details">

                <h1 class="show-title">
                    <%= listing.title %>
                </h1>

                <p class="show-owner text-muted mb-1">
                    Hosted by <strong>
                        <%= listing.owner ? listing.owner.username : "Unknown Host" %>
                    </strong>
                </p>

                <p class="show-location">
                    <%= listing.location %>, <%= listing.country %>
                </p>

                <hr class="show-divider">

                <p class="show-description">
                    <%= listing.description %>
                </p>

            </div>

            <div class="show-action-panel">

                <div class="price-box">
                    <span class="price-amount">
                        ₹<%= listing.price.toLocaleString("en-IN") %>
                    </span>
                    <span class="price-unit">/ night</span>
                </div>

                <div class="show-buttons">

                    <% if(currUser && listing.owner && currUser._id.toString()===listing.owner._id.toString()) { %>

                        <a href="/listings/<%= listing._id %>/edit" class="edit-btn">
                            Edit Listing
                        </a>

                        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="delete-form">
                            <button type="submit" class="delete-btn">
                                Delete Listing
                            </button>
                        </form>

                        <% } %>

                </div>

            </div>

        </div>

        <!-- ================= REVIEWS ================= -->

        <hr class="my-5 section-divider">

        <div class="review-section col-8 offset-2 mb-5">

            <h2 class="h4 mb-3 fw-semibold text-dark">Leave a Review</h2>

            <form action="/listings/<%= listing._id %>/reviews" method="POST" class="review-form needs-validation"
                novalidate>

                <div class="mb-3">
                    <label for="rating" class="form-label fw-medium">Rating</label>

                    <div class="d-flex align-items-center gap-3">
                        <input type="range" min="1" max="5" id="rating" name="review[rating]"
                            class="form-range custom-slider" value="5" required>

                        <span class="rating-display fw-bold badge bg-dark text-white px-2.5 py-2">
                            5 ★
                        </span>
                    </div>
                </div>

                <div class="mb-4 position-relative">
                    <label for="comment" class="form-label fw-medium">Comments</label>

                    <textarea id="comment" name="review[comment]" class="form-control premium-textarea" rows="4"
                        placeholder="Share your experience here..." required minlength="5"></textarea>

                    <div class="invalid-feedback">
                        Please provide a short review comment (at least 5 characters).
                    </div>

                    <div class="valid-feedback">
                        Looks fantastic!
                    </div>
                </div>

                <button type="submit" class="btn btn-outline-dark submit-review-btn px-4 py-2 fw-semibold">
                    Submit Review
                </button>

            </form>
        </div>

        <% if(listing.reviews && listing.reviews.length> 0) { %>

            <hr class="my-4">

            <h3 class="h5 mb-3 fw-semibold text-dark">All Reviews</h3>

            <div class="row g-3">

                <% for(let review of listing.reviews) { %>

                    <div class="col-md-6">
                        <div class="card h-100 review-card border border-light-subtle shadow-sm">

                            <div class="card-body d-flex flex-column justify-content-between p-3">

                                <div>

                                    <div class="d-flex justify-content-between align-items-center mb-2">

                                        <h6 class="card-title fw-bold text-dark mb-0">
                                            <%= review.author ? review.author.username : "Anonymous Explorer" %>
                                        </h6>

                                        <span class="badge bg-dark text-white fw-semibold">
                                            <%= review.rating %> ★
                                        </span>

                                    </div>

                                    <p class="card-text text-muted small mb-0 review-comment-text">
                                        <%= review.comment %>
                                    </p>

                                </div>

                                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    method="POST" class="mt-3 text-end">

                                    <button class="btn btn-sm btn-outline-danger py-1 px-2.5 rounded-3">
                                        Delete
                                    </button>

                                </form>

                            </div>
                        </div>
                    </div>

                    <% } %>

            </div>

            <% } %>

    </div>

    <!-- ================= MAP SECTION ================= -->
    <div class="map-section-container">

        <p class="map-subtitle">
            <%= listing.location %>,
                <span>
                    <%= listing.country %>
                </span>
        </p>

        <!-- ✅ DATASET METHOD -->
        <div id="map" data-listing='<%- JSON.stringify(listing) %>'>
        </div>

    </div>

    <!-- ================= LEAFLET ================= -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <!-- ================= YOUR MAP JS ================= -->
    <script src="/js/map.js"></script>