<% layout("/layouts/boilerplate") %>

    <div class="container mt-4">

        <h2 class="category-title">
            Search Results for "<%= searchText %>"
        </h2>

        <div class="listings-grid">

            <% if (!results || results.length===0) { %>

                <p class="text-muted mt-3">
                    No results found for "<%= searchText %>"
                </p>

                <% } else { %>

                    <% for (let listing of results) { %>

                        <a href="/listings/<%= listing._id %>" class="listing-card-link">

                            <article class="listing-card">

                                <div class="listing-image-wrapper">

                                    <img src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267' %>"
                                        alt="<%= listing.title %>" class="listing-image">

                                </div>

                                <div class="listing-info">

                                    <h3 class="category-card-location">
                                        <%= listing.location %>, <%= listing.country %>
                                    </h3>

                                    <p class="category-card-price">
                                        <span class="price">
                                            ₹<%= listing.price.toLocaleString("en-IN") %>
                                        </span>
                                        <span class="unit">/ night</span>
                                    </p>

                                </div>

                            </article>

                        </a>

                        <% } %>

                            <% } %>

        </div>

    </div>